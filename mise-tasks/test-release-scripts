#!/usr/bin/env bash
#MISE description="Dry-run build and release tasks and check their commands"
source "$MISE_PROJECT_ROOT/scripts/lib.sh"

out_dir="$ROOT/build/test"
mkdir -p "$out_dir"

# dry_run_task <task> <expected substring...>
dry_run_task() {
  local task=$1 output="$out_dir/$1-dry-run.txt"
  shift
  DRY_RUN=1 VERSION=9.9.9 BUILD_VERSION=4 BASE_BUILD_VERSION=3 RELEASE_TAG='' RELEASE_TITLE='' RELEASE_NOTES="Dry run" \
    "$ROOT/mise-tasks/$task" >"$output"
  for expected in "$@"; do
    grep -qF -- "$expected" "$output" || fail "$task dry run is missing '$expected' (see $output)"
  done
}

dry_run_task local-dmg 'hdiutil create' 'GithubPanel-9.9.9.dmg' 'local testing'
dry_run_task dmg 'notarytool submit' 'stapler staple' 'spctl --assess --type open'
dry_run_task appcast 'generate_appcast' 'appcast.xml' 'releases/download/v9.9.9'
dry_run_task release 'notarytool submit' 'stapler staple' 'generate_appcast' 'appcast.xml' \
  'gh release create v9.9.9' 'GithubPanel-9.9.9.dmg' 'Dry run'

if DRY_RUN=1 BUILD_VERSION=3 BASE_BUILD_VERSION=3 "$ROOT/mise-tasks/dmg" >/dev/null 2>&1; then
  fail "dmg should reject a BUILD_VERSION that is not greater than BASE_BUILD_VERSION"
fi

# Personal signing settings must apply to builds, but never to test builds.
GITHUB_PANEL_DEVELOPMENT_TEAM=TESTTEAM GITHUB_PANEL_CODE_SIGN_IDENTITY="Apple Development: Test" \
  dry_run_task test 'DEVELOPMENT_TEAM= CODE_SIGN_IDENTITY=- CODE_SIGN_STYLE=Manual'
GITHUB_PANEL_DEVELOPMENT_TEAM=TESTTEAM GITHUB_PANEL_CODE_SIGN_IDENTITY="Apple Development: Test" \
  dry_run_task test-performance 'DEVELOPMENT_TEAM= CODE_SIGN_IDENTITY=- CODE_SIGN_STYLE=Manual'
GITHUB_PANEL_DEVELOPMENT_TEAM=TESTTEAM GITHUB_PANEL_CODE_SIGN_IDENTITY="Apple Development: Test" \
  dry_run_task build 'DEVELOPMENT_TEAM=TESTTEAM CODE_SIGN_IDENTITY=Apple Development: Test CODE_SIGN_STYLE=Automatic'

echo "Build and release task dry runs look good."
